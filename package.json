{
  "name": "ics-canvas-notion-sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "sync": "tsx src/cli.ts",
    "health-check": "tsx scripts/check-health.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:types-and-build": "tsc -b tsconfig.build.json tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@notionhq/client": "5.23.0",
    "node-ical": "0.26.1",
    "pino": "9.7.0",
    "sanitize-html": "2.17.0",
    "turndown": "7.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "@types/sanitize-html": "2.16.0",
    "@types/turndown": "5.0.5",
    "eslint": "10.6.0",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.9"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
