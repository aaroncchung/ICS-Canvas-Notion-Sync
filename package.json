{
  "name": "ics-canvas-notion-sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "tsc": "node node_modules/typescript-native/bin/tsc",
    "build": "npm run tsc -- -p tsconfig.build.json",
    "sync": "node src/cli.ts",
    "health-check": "node scripts/check-health.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:types-and-build": "npm run tsc -- -b tsconfig.build.json tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@notionhq/client": "5.26.0",
    "node-ical": "0.27.2",
    "pino": "10.3.1",
    "sanitize-html": "2.17.7",
    "turndown": "7.2.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.5",
    "@types/sanitize-html": "2.16.1",
    "@types/turndown": "5.0.6",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "typescript-native": "npm:typescript@7.0.2",
    "vitest": "5.0.1"
  }
}
