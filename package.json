{
  "name": "ics-canvas-notion-sync",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "tsc": "node node_modules/typescript-native/bin/tsc",
    "build": "npm run tsc -- -p tsconfig.build.json",
    "sync": "node src/cli.ts",
    "health-check": "node scripts/check-health.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:types-and-build": "npm run tsc -- -b tsconfig.build.json tsconfig.test.json extension/tsconfig.json && npm run build:extension",
    "build:extension": "node extension/build.mjs",
    "test:extension": "vitest run extension/tests",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@notionhq/client": "5.27.0",
    "node-ical": "0.27.3",
    "pino": "10.4.0",
    "sanitize-html": "2.18.0",
    "turndown": "7.2.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.5",
    "@types/node": "24.19.2",
    "@types/sanitize-html": "2.16.2",
    "@types/turndown": "5.0.6",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "typescript-native": "npm:typescript@7.0.2",
    "vitest": "5.0.5"
  }
}
